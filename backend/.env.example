# ── MindForm backend environment ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit your real .env.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/mindform

# JWT — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional: serve the built frontend from Express (single-service deploys)
SERVE_FRONTEND=false
